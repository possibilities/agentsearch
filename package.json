{
  "name": "agentsearch",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded web research for agents: cited answers and ranked hits, with a spend ledger.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/possibilities/agentsearch.git"
  },
  "bin": {
    "agentsearch": "cli/agentsearch.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1",
    "typescript": "^5"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate:schema": "bun run scripts/generate-schema.ts && biome check --write secrets.schema.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check . && tsc --noEmit && bun test"
  }
}
