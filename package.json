{
  "name": "agentsearch",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded web research for agents: cited answers and ranked hits, with a spend ledger.",
  "bin": {
    "agentsearch": "cli/agentsearch.ts"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1",
    "typescript": "^5"
  },
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched cli src test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check . && tsc --noEmit && bun test"
  }
}
